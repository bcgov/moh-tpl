    <description>Updated the DateIdFormula for Hospitalization: ,update Standard_Daily_Rate__c in before insert
This flow performs the following actions: New Version V6

1- Populates &apos;Total Cost Override&apos;, PHN, and DateID for MSP, Ambulance, Pharmacare, Continuing Care, Future Care, and Hospitalization records.
2- Populates Facility Name from Facility Code for Ambulance and Hospitalization records.
3- Populates price for selected service for integration Hospitalization records.
4- Populates Tear level, Procedure code, and service type for manual Hospitalization records.
5- Updated formulas for Practitioner Name, Diagnostic Code, Diagnostic Description</description>
    <environments>Default</environments>
    <formulas>
        <name>AmbulanceTotalCostOverride</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!$Record.Total_Cost_Override__c}), {!$Record.Basic_Amount__c}, {!$Record.Total_Cost_Override__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>dateidformula</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(if(Text({!$Record.Date_of_Service__c})==null,&apos;00000000&apos;,TEXT({!$Record.Date_of_Service__c})), &apos;_&apos;, &apos;&apos; ) &amp; &apos;&apos; &amp; {!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>DateIdValueforHospitalizationformula</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
  IF(
    ISBLANK(TEXT({!currentRecord.Date_of_Service__c})),
    &apos;00000000&apos;,
    TEXT({!currentRecord.Date_of_Service__c})
  ),
  &apos;_&apos;,
  &apos;&apos;
) &amp; {!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>DiagnosticCodeFormula</name>
        <dataType>String</dataType>
        <expression>IF( ISBLANK({!$Record.Diagnostic_Code__c}), {!$Record.Diagnostic_Code_1__c} &amp; &quot;; &quot; &amp; {!$Record.Diagnostic_Code_2__c} &amp; &quot;; &quot; &amp; {!$Record.Diagnostic_Code_3__c}, {!$Record.Diagnostic_Code__c})</expression>
    </formulas>
    <formulas>
        <name>DiagnosticDescriptionFormula</name>
        <dataType>String</dataType>
        <expression>IF( ISBLANK({!$Record.Diagnostic_Description__c}), {!$Record.Diagnostic_Description_1__c} &amp; &quot;; &quot; &amp; {!$Record.Diagnostic_Description_2__c} &amp; &quot;; &quot; &amp; {!$Record.Diagnostic_Description_3__c}, {!$Record.Diagnostic_Description__c})</expression>
    </formulas>
    <formulas>
        <description>this is used for assignment of the healthcare service facility name to the Service type on the healthcare cost record.</description>
        <name>HealthCareServiceNameAssignmentToServiceType</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        LEN($Record.Service_Provided_by_Facility__r.Name) &gt; 5,
        MID($Record.Service_Provided_by_Facility__r.Name, 4, 1) = &quot;-&quot;
    ),
    MID(
        $Record.Service_Provided_by_Facility__r.Name,
        5,
        LEN($Record.Service_Provided_by_Facility__r.Name)
    ),
    $Record.Service_Provided_by_Facility__r.Name
	)</expression>
    </formulas>
    <formulas>
        <name>HospitalizationTotalCostOverride</name>
        <dataType>Currency</dataType>
        <expression>IF(
   {!isNewlyCreatedRecord},
    {!$Record.Total_Cost_Override__c},
    IF(
        OR(
            {!$Record.Number_of_Days__c}&lt;&gt; {!$Record__Prior.Number_of_Days__c},
            {!$Record.Service_Provided_by_Facility__c} &lt;&gt; {!$Record__Prior.Service_Provided_by_Facility__c},
            {!$Record.Standard_Daily_Rate__c} &lt;&gt; {!$Record__Prior.Standard_Daily_Rate__c},
            {!$Record.Total_Costs_Standard__c} &lt;&gt; {!$Record__Prior.Total_Costs_Standard__c}
        ),
        NULL,
        {!$Record.Total_Cost_Override__c}
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>isNewlyCreatedRecord</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>MspTotalCostOverride</name>
        <dataType>Currency</dataType>
