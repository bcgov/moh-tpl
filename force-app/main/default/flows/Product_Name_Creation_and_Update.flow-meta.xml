    <description>This flow generates a Product Name for new product creation or updates to existing products while preventing duplicate entries.</description>
    <environments>Default</environments>
    <formulas>
        <name>Generic_Product_Name</name>
        <dataType>String</dataType>
        <expression>{!ServiceTypeRecord} + &apos;-&apos;+ {!EffectiveYear}</expression>
    </formulas>
    <formulas>
        <name>Specific_Product_name</name>
        <dataType>String</dataType>
        <expression>{!siteCode}+&apos;-&apos;+{!ServiceTypeRecord}+&apos;-&apos;+{!EffectiveYear}</expression>
    </formulas>
    <formulas>
        <name>SurgicalDay_Product_Name</name>
        <dataType>String</dataType>
        <expression>{!$Record.Intervention_Code_CCI__c}+&apos;-&apos;+ {!ServiceTypeRecord} + &apos;-&apos;+CASE(TEXT({!$Record.CCI_Level__c}),&apos;Tier 1&apos;, &apos;Low&apos;,&apos;Tier 2&apos;, &apos;Med&apos;,&apos;Tier 3&apos;, &apos;High&apos;,&apos;&apos;)+ &apos;-&apos;+ {!EffectiveYear}</expression>
    </formulas>
