@IsTest
private class DocxSingleDocumentQueueableTest {
    @IsTest
    static void execute_createsSinglePrintableDocx() {
        Id caseId = DocGenTestFactory.insertFullTestCase();

        Test.startTest();
        System.enqueueJob(new DocxSingleDocumentQueueable(caseId));
        Test.stopTest();

        List<ContentDocumentLink> links = [
            SELECT ContentDocumentId,
                   ContentDocument.Title,
                   ContentDocument.FileExtension
            FROM ContentDocumentLink
            WHERE LinkedEntityId = :caseId
              AND ContentDocument.Title LIKE 'Ministers%Certificate%'
              AND ContentDocument.FileExtension = 'docx'
            ORDER BY ContentDocument.CreatedDate DESC
            LIMIT 1
        ];

        System.assertEquals(1, links.size(),
            'Async generation should create one printable DOCX linked to the Case.');
        System.assert(links[0].ContentDocument.Title.endsWith('.docx'),
            'Async output should be a DOCX, not a ZIP. Title=' + links[0].ContentDocument.Title);
    }

    @IsTest
    static void pollDocument_returnsAsyncDocx() {
        Id caseId = DocGenTestFactory.insertFullTestCase();

        Test.startTest();
        System.enqueueJob(new DocxSingleDocumentQueueable(caseId));
        Test.stopTest();

        String contentDocumentId = DocxGeneratorController.pollDocument(caseId, 'testJobId');

        System.assertNotEquals(null, contentDocumentId,
            'Polling should return the generated DOCX ContentDocumentId.');
        ContentVersion cv = [
            SELECT Title, FileExtension
            FROM ContentVersion
            WHERE ContentDocumentId = :contentDocumentId
            ORDER BY VersionNumber DESC
            LIMIT 1
        ];
        System.assertEquals('docx', cv.FileExtension,
            'Polling should return the printable DOCX generated by the async path.');
    }
}
