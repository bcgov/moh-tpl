    <decisions>
        <name>Check_if_there_is_a_need_to_clone_the_product</name>
        <label>Check if there is a need to clone the product</label>
        <locationX>314</locationX>
        <locationY>782</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
