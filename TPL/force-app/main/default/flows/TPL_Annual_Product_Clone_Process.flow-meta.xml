    </decisions>
    <description>This flow will perform the following actions:

Deactivate all active products from the previous year.
Clone only the deactivated active products from the previous year for the current year.

Additional considerations:

Products that were already deactivated in the previous year will not be cloned.
New products already created for the current year will not be recreated.
Any deactivated product for the current year will remain deactivated.</description>
    <environments>Default</environments>
    <formulas>
        <name>CurrentYearInactiveProductCount</name>
        <dataType>Number</dataType>
        <expression>{!CurrentYearTotalProductCount} - {!CurrentYearActiveProductCount}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>New_Effective_End_Date</name>
        <dataType>Date</dataType>
        <expression>DATE (Year ( {!Loop_through_prior_year_active_products.Effective_End_Date__c} ) + 1, Month ( {!Loop_through_prior_year_active_products.Effective_End_Date__c} ), DAY ({!Loop_through_prior_year_active_products.Effective_End_Date__c}))</expression>
    </formulas>
    <formulas>
        <name>New_Effective_Start_Date</name>
        <dataType>Date</dataType>
        <expression>DATE (Year ( {!Loop_through_prior_year_active_products.Effective_Start_Date__c} ) + 1, Month ({!Loop_through_prior_year_active_products.Effective_Start_Date__c}), DAY ({!Loop_through_prior_year_active_products.Effective_Start_Date__c}))</expression>
    </formulas>
    <formulas>
        <name>New_Effective_Year</name>
        <dataType>String</dataType>
        <expression>TEXT ( YEAR ( TODAY() ) )</expression>
    </formulas>
    <formulas>
        <name>Prior_Effective_Year</name>
        <dataType>String</dataType>
        <expression>TEXT ( YEAR (TODAY() ) -1 )</expression>
    </formulas>
